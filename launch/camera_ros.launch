<launch>
    <arg name="first_device" default="/dev/video0" />
    <arg name="republish_raw" default="true"/>

    <!-- Первая камера -->
    <node name="first_camera" pkg="uvc_camera" type="uvc_camera_node" output="screen">
      <remap from="image_raw" to="first_camera/image_raw" />
      <remap from="camera_info" to="first_camera/camera_info" />
      <param name="device" value="$(arg first_device)" />
      <param name="width" value="640" />
      <param name="height" value="480" />
      <param name="format" value="raw" />
      <param name="fps" value="5" />
      <param name="brightness" value="0" />
      <param name="contrast" value="0" />
      <param name="saturation" value="66" />
      <param name="image_raw/compressed/jpeg_quality" value="25"/>
      <param name="image_raw/compressed/jpeg_progressive" value="true"/>
      <param name="image_raw/compressed/jpeg_optimize" value="true"/>
    </node>


    <!-- Републикация изображений для первой камеры -->
    <!--node if="$(arg republish_raw)" name="republish_raw" type="republish" pkg="image_transport" 
	args="raw in:=/first_camera/image_raw compressed out:=/first_camera/image_raw" /-->

</launch>
